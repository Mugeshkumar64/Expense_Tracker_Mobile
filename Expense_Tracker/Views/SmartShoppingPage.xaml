<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Expense_Tracker.Models"
             x:Class="Expense_Tracker.Views.SmartShoppingPage"
             Title="Smart Shopping"
             BackgroundColor="{StaticResource BgBase}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Live Calculation Hero Card (Midnight Navy) -->
            <Border BackgroundColor="{StaticResource HeroBg}" StrokeShape="RoundRectangle 22" Stroke="{StaticResource HeroBorder}" Padding="20,18">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="🛒 PURCHASE TOTAL" FontSize="11" FontAttributes="Bold" TextColor="#93C5FD" CharacterSpacing="1" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,3">
                            <Label Text="AUTO-LINKED EXPENSE" TextColor="#6EE7B7" FontSize="9" FontAttributes="Bold" CharacterSpacing="0.5" />
                        </Border>
                    </Grid>
                    <Label x:Name="LblTotalCalculated" Text="₹0.00" FontSize="36" FontAttributes="Bold" TextColor="White" Margin="0,2,0,8" />
                    
                    <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="#1E293B" Stroke="{StaticResource HeroBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="QUANTITY *" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="0.5" />
                                <Entry x:Name="TxtQuantity" Text="1" Keyboard="Numeric" TextColor="White" FontSize="16" FontAttributes="Bold" TextChanged="OnPriceOrQtyChanged" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="{StaticResource HeroBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="UNIT PRICE (₹) *" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="0.5" />
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="₹" TextColor="#93C5FD" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,4,0" />
                                    <Entry Grid.Column="1" x:Name="TxtUnitPrice" Placeholder="0.00" Keyboard="Numeric" TextColor="White" PlaceholderColor="#64748B" FontSize="16" FontAttributes="Bold" TextChanged="OnPriceOrQtyChanged" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Product & Store Details Card -->
            <Border BackgroundColor="{StaticResource SurfaceCard}" StrokeShape="RoundRectangle 18" Stroke="{StaticResource Line}" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Product &amp; Store Details" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />

                    <!-- Product Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Product Name *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSub}" />
                        <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Line}" Padding="12,2">
                            <Entry x:Name="TxtProductName" Placeholder="e.g. Rice, Milk, Cooking Oil" TextColor="{StaticResource TextMain}" PlaceholderColor="{StaticResource TextDim}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Category & Unit -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Category" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSub}" />
                            <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Line}" Padding="12,2">
                                <Picker x:Name="PickerCategory" Title="Groceries" TextColor="{StaticResource TextMain}" TitleColor="{StaticResource TextDim}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Unit" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSub}" />
                            <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Line}" Padding="12,2">
                                <Picker x:Name="PickerUnit" TextColor="{StaticResource TextMain}" TitleColor="{StaticResource TextDim}">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>kg</x:String>
                                            <x:String>g</x:String>
                                            <x:String>litre</x:String>
                                            <x:String>ml</x:String>
                                            <x:String>piece</x:String>
                                            <x:String>packet</x:String>
                                            <x:String>dozen</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Shop Name & Location -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Shop Name *" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSub}" />
                            <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Line}" Padding="12,2">
                                <Entry x:Name="TxtShopName" Placeholder="e.g. Supermart" TextColor="{StaticResource TextMain}" PlaceholderColor="{StaticResource TextDim}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Shop Location" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSub}" />
                            <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Line}" Padding="12,2">
                                <Entry x:Name="TxtShopLocation" Placeholder="Optional" TextColor="{StaticResource TextMain}" PlaceholderColor="{StaticResource TextDim}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Payment Method & Date -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Payment" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSub}" />
                            <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Line}" Padding="12,2">
                                <Picker x:Name="PickerPayment" TextColor="{StaticResource TextMain}">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>UPI</x:String>
                                            <x:String>Cash</x:String>
                                            <x:String>Credit Card</x:String>
                                            <x:String>Debit Card</x:String>
                                            <x:String>Other</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Date" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSub}" />
                            <Border BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 12" Stroke="{StaticResource Line}" Padding="12,2">
                                <DatePicker x:Name="PickerDate" TextColor="{StaticResource TextMain}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Linked Note -->
                    <Border BackgroundColor="{StaticResource PositiveSoft}" Stroke="{StaticResource PositiveBorder}" StrokeShape="RoundRectangle 12" Padding="12,10">
                        <Label Text="⚡ Saving creates one linked expense transaction, so it is never counted twice." FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Positive}" LineHeight="1.3" />
                    </Border>

                    <!-- Submit Button -->
                    <Button x:Name="BtnSavePurchase" Text="Save Purchase"
                            BackgroundColor="{StaticResource AccentPrimary}" TextColor="White"
                            FontAttributes="Bold" CornerRadius="14" HeightRequest="50"
                            Clicked="OnSavePurchaseClicked" />

                </VerticalStackLayout>
            </Border>

            <!-- Recent Purchases Section -->
            <Label Text="Recent Purchases" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextMain}" Margin="4,4,0,0" />

            <VerticalStackLayout x:Name="LayoutPurchases" Spacing="8">
                <Label Text="No purchases recorded yet." TextColor="{StaticResource TextDim}" FontSize="13" HorizontalOptions="Center" Padding="20" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
