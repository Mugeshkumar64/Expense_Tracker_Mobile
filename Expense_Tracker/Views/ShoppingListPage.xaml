<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Expense_Tracker.Models"
             x:Class="Expense_Tracker.Views.ShoppingListPage"
             Title="Shopping List &amp; Budget"
             BackgroundColor="{StaticResource BgBase}">

    <RefreshView x:Name="Refresher" Refreshing="OnRefreshing" RefreshColor="{StaticResource AccentPrimary}">
        <ScrollView>
            <VerticalStackLayout Spacing="18" Padding="16">

                <!-- Add List Item Card -->
                <Border BackgroundColor="{StaticResource SurfaceCard}" StrokeShape="RoundRectangle 18" Stroke="{StaticResource Line}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Add Planned Item" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                        
                        <Grid ColumnDefinitions="*,80,70,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 10" Stroke="{StaticResource Line}" Padding="8,0">
                                <Entry x:Name="TxtItemName" Placeholder="Product" TextColor="{StaticResource TextMain}" PlaceholderColor="{StaticResource TextDim}" FontSize="13" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 10" Stroke="{StaticResource Line}" Padding="8,0">
                                <Entry x:Name="TxtItemQty" Text="1" Keyboard="Numeric" TextColor="{StaticResource TextMain}" FontSize="13" />
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 10" Stroke="{StaticResource Line}">
                                <Picker x:Name="PickerItemUnit" TextColor="{StaticResource TextMain}" FontSize="12">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>kg</x:String>
                                            <x:String>g</x:String>
                                            <x:String>litre</x:String>
                                            <x:String>ml</x:String>
                                            <x:String>piece</x:String>
                                            <x:String>packet</x:String>
                                            <x:String>dozen</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                            <Button Grid.Column="3" Text="Add" BackgroundColor="{StaticResource AccentPrimary}" TextColor="White"
                                    FontAttributes="Bold" CornerRadius="10" HeightRequest="40" Padding="14,0"
                                    Clicked="OnAddItemClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Budget & Price Estimation Summary Card -->
                <Border BackgroundColor="{StaticResource SurfaceCard}" StrokeShape="RoundRectangle 18" Stroke="{StaticResource Positive}" StrokeThickness="1" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Estimated Total:" TextColor="{StaticResource TextSub}" FontSize="13" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="LblEstimatedTotal" Text="₹0.00" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextMain}" VerticalOptions="Center" />
                        </Grid>

                        <Label x:Name="LblBudgetStatus" Text="Set target budget in Settings" FontSize="12" TextColor="{StaticResource TextDim}" />
                        
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Estimated Savings vs Usual:" TextColor="{StaticResource TextSub}" FontSize="12" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="LblEstimatedSavings" Text="₹0.00" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Positive}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Items Header -->
                <Label Text="Planned Items" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextMain}" Margin="4,4,0,0" />

                <!-- Items Container -->
                <VerticalStackLayout x:Name="LayoutItems" Spacing="8">
                    <Label Text="Your list is empty. Add products you plan to buy." TextColor="{StaticResource TextDim}" FontSize="13" HorizontalOptions="Center" Padding="20" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
