<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Expense_Tracker.Models"
             x:Class="Expense_Tracker.Views.ShopsPage"
             Title="Shops Directory"
             BackgroundColor="{StaticResource BgBase}">

    <RefreshView x:Name="Refresher" Refreshing="OnRefreshing" RefreshColor="{StaticResource AccentPrimary}">
        <ScrollView>
            <VerticalStackLayout Spacing="18" Padding="16">

                <!-- Add Shop Card -->
                <Border BackgroundColor="{StaticResource SurfaceCard}" StrokeShape="RoundRectangle 18" Stroke="{StaticResource Line}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Add New Shop" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                        
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 10" Stroke="{StaticResource Line}" Padding="8,0">
                                <Entry x:Name="TxtShopName" Placeholder="Shop Name *" TextColor="{StaticResource TextMain}" PlaceholderColor="{StaticResource TextDim}" FontSize="13" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 10" Stroke="{StaticResource Line}" Padding="8,0">
                                <Entry x:Name="TxtShopLoc" Placeholder="Location" TextColor="{StaticResource TextMain}" PlaceholderColor="{StaticResource TextDim}" FontSize="13" />
                            </Border>
                            <Button Grid.Column="2" Text="Add" BackgroundColor="{StaticResource AccentPrimary}" TextColor="White"
                                    FontAttributes="Bold" CornerRadius="10" HeightRequest="40" Padding="14,0"
                                    Clicked="OnAddShopClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Explanatory Note -->
                <Label Text="Total spending indicates overall purchases. 'Lowest-price matches' counts products where this shop holds the lowest recorded unit price." FontSize="11" TextColor="{StaticResource TextDim}" LineHeight="1.3" />

                <!-- Shops Header -->
                <Label Text="Registered Shops" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextMain}" Margin="4,4,0,0" />

                <!-- Shops Container -->
                <VerticalStackLayout x:Name="LayoutShops" Spacing="8">
                    <Label Text="No shops registered yet." TextColor="{StaticResource TextDim}" FontSize="13" HorizontalOptions="Center" Padding="20" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
