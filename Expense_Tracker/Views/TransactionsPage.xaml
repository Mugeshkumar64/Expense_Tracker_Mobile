<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Expense_Tracker.Models"
             x:Class="Expense_Tracker.Views.TransactionsPage"
             Title="Transactions"
             BackgroundColor="{StaticResource BgBase}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,12">

        <!-- Cashflow Summary Hero Card (Midnight Navy) -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource HeroBg}" StrokeShape="RoundRectangle 22" Stroke="{StaticResource HeroBorder}" Padding="18,16" Margin="0,0,0,12">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="📊 Filtered Net Cashflow" FontSize="11" FontAttributes="Bold" TextColor="#93C5FD" CharacterSpacing="1" VerticalOptions="Center" />
                    <Border Grid.Column="1" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,3">
                        <Label x:Name="LblTxCount" Text="0 entries" TextColor="#E2E8F0" FontSize="10" FontAttributes="Bold" />
                    </Border>
                </Grid>
                <Label x:Name="LblNetFlow" Text="₹0.00" FontSize="30" FontAttributes="Bold" TextColor="White" Margin="0,2,0,8" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                    <Border Grid.Column="0" BackgroundColor="#1E293B" Stroke="{StaticResource HeroBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Border WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 8" BackgroundColor="#122822" StrokeThickness="0">
                                <Label Text="↓" TextColor="#6EE7B7" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="INCOME" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="0.5" />
                                <Label x:Name="LblTxIncome" Text="₹0" FontSize="13" FontAttributes="Bold" TextColor="White" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="{StaticResource HeroBorder}" StrokeShape="RoundRectangle 12" Padding="10,8">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Border WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 8" BackgroundColor="#2A1820" StrokeThickness="0">
                                <Label Text="↑" TextColor="#FDA4AF" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="1">
                                <Label Text="EXPENSES" FontSize="9" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="0.5" />
                                <Label x:Name="LblTxExpense" Text="₹0" FontSize="13" FontAttributes="Bold" TextColor="White" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource SurfaceCard}" StrokeShape="RoundRectangle 16" Stroke="{StaticResource Line}" Padding="14,2" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*">
                <Label Grid.Column="0" Text="🔍" FontSize="14" VerticalOptions="Center" Margin="0,0,8,0" />
                <Entry Grid.Column="1" x:Name="TxtSearch" Placeholder="Search title, category, or shop..."
                       TextColor="{StaticResource TextMain}" PlaceholderColor="{StaticResource TextDim}"
                       TextChanged="OnSearchTextChanged" />
            </Grid>
        </Border>

        <!-- Filters Row -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="BtnFilterAll" Text="All" CornerRadius="12" HeightRequest="36" Padding="14,0"
                    BackgroundColor="{StaticResource AccentPrimary}" TextColor="White" FontAttributes="Bold"
                    Clicked="OnFilterAllClicked" />
            <Button x:Name="BtnFilterIncome" Text="Income" CornerRadius="12" HeightRequest="36" Padding="14,0"
                    BackgroundColor="{StaticResource SurfaceCard}" TextColor="{StaticResource TextSub}"
                    Clicked="OnFilterIncomeClicked" />
            <Button x:Name="BtnFilterExpense" Text="Expense" CornerRadius="12" HeightRequest="36" Padding="14,0"
                    BackgroundColor="{StaticResource SurfaceCard}" TextColor="{StaticResource TextSub}"
                    Clicked="OnFilterExpenseClicked" />
            <Picker x:Name="PickerCategory" Title="Category" HeightRequest="36" TextColor="{StaticResource TextMain}"
                    TitleColor="{StaticResource TextSub}" BackgroundColor="{StaticResource SurfaceCard}"
                    SelectedIndexChanged="OnCategorySelected" />
        </HorizontalStackLayout>

        <!-- Transactions List -->
        <RefreshView Grid.Row="3" x:Name="Refresher" Refreshing="OnRefreshing" RefreshColor="{StaticResource AccentPrimary}">
            <CollectionView x:Name="CvTransactions" EmptyView="No transactions found matching criteria.">
                <CollectionView.EmptyViewTemplate>
                    <DataTemplate>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="30">
                            <Label Text="📄" FontSize="36" HorizontalOptions="Center" />
                            <Label Text="No records found" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center" />
                            <Label Text="Tap '+ Record' below to add your first transaction." FontSize="12" TextColor="{StaticResource TextDim}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.EmptyViewTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Transaction">
                        <SwipeView Margin="0,0,0,8">
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Delete" BackgroundColor="{StaticResource Negative}" Invoked="OnDeleteTransactionInvoked" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border BackgroundColor="{StaticResource SurfaceCard}" StrokeShape="RoundRectangle 16" Stroke="{StaticResource Line}" Padding="14,12">
                                <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="12">
                                    <!-- Icon Box -->
                                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{StaticResource Surface}"
                                            StrokeThickness="0">
                                        <Label Text="{Binding TypeIcon}" TextColor="{Binding AmountColor}"
                                               FontSize="16" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <!-- Details -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Title}" TextColor="{StaticResource TextMain}" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Subtitle}" TextColor="{StaticResource TextDim}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <!-- Amount -->
                                    <Label Grid.Column="2" Text="{Binding FormattedAmount}" TextColor="{Binding AmountColor}"
                                           FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Floating Add Button -->
        <Button Grid.Row="3" Text="＋ Record" FontSize="14" FontAttributes="Bold"
                BackgroundColor="{StaticResource AccentPrimary}" TextColor="White"
                HeightRequest="48" CornerRadius="24" Padding="18,0"
                HorizontalOptions="End" VerticalOptions="End" Margin="16"
                Clicked="OnAddClicked" />

    </Grid>

</ContentPage>
