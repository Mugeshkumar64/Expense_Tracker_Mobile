<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryDark">#1D4ED8</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#0F172A</Color>
    <Color x:Key="SecondaryDarkText">#475569</Color>
    <Color x:Key="Tertiary">#3B82F6</Color>

    <!-- ExpenseTrack Modern Fintech Theme Colors -->
    <!-- Porcelain Canvas · Pure White Cards · Midnight Navy Hero · Fintech Indigo-Blue Primary -->
    <Color x:Key="BgOuter">#E8EEF5</Color>
    <Color x:Key="BgBase">#F6F8FB</Color>
    <Color x:Key="Surface">#F1F5F9</Color>
    <Color x:Key="SurfaceCard">#FFFFFF</Color>
    <Color x:Key="SurfaceHover">#E2E8F0</Color>
    <Color x:Key="Line">#E4E9F2</Color>
    <Color x:Key="LineStrong">#CBD5E1</Color>
    <Color x:Key="AccentPrimary">#2563EB</Color>
    <Color x:Key="AccentSecondary">#0F172A</Color>
    <Color x:Key="AccentSoft">#EFF6FF</Color>
    <Color x:Key="AccentBorder">#BFDBFE</Color>
    <Color x:Key="HeroBg">#0F172A</Color>
    <Color x:Key="HeroBorder">#1E293B</Color>
    <Color x:Key="TextMain">#0F172A</Color>
    <Color x:Key="TextSub">#475569</Color>
    <Color x:Key="TextDim">#64748B</Color>
    <Color x:Key="Positive">#059669</Color>
    <Color x:Key="PositiveSoft">#ECFDF5</Color>
    <Color x:Key="PositiveBorder">#A7F3D0</Color>
    <Color x:Key="Negative">#E11D48</Color>
    <Color x:Key="NegativeSoft">#FFF1F2</Color>
    <Color x:Key="Gold">#D97706</Color>
    <Color x:Key="GoldSoft">#FFFBEB</Color>
    <Color x:Key="GoldBorder">#FDE68A</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#0F172A</Color>
    <Color x:Key="OffBlack">#0F172A</Color>

    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E4E9F2</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>